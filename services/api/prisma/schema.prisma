model ProjectTemplate {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  name               String    @db.VarChar(200)
  description        String?   @db.Text
  type               String    @default("project") @db.VarChar(20)
  category           String?   @db.VarChar(100)
  ownerId            String?   @map("owner_id") @db.Uuid
  isPublic           Boolean   @default(false) @map("is_public")
  sourceProjectId    String?   @map("source_project_id") @db.Uuid
  taskCount          Int       @default(0) @map("task_count")
  tags               String[]  @default([])
  taskSnapshot       Json      @map("task_snapshot")
  dependencySnapshot Json      @map("dependency_snapshot")
  createdBy          String?   @map("created_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  owner         User?    @relation("TemplateOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tenant        Tenant   @relation("TemplateTenant", fields: [tenantId], references: [id], onDelete: Restrict)
  sourceProject Project? @relation("TemplateSourceProject", fields: [sourceProjectId], references: [id], onDelete: SetNull)

  @@index([tenantId, type])
  @@index([tenantId, isPublic])
  @@map("project_templates")
}

model AutomationRule {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  projectId       String?   @map("project_id") @db.Uuid
  name            String    @db.VarChar(200)
  description     String?   @db.Text
  triggerType     String    @map("trigger_type") @db.VarChar(30)
  triggerConfig   Json      @map("trigger_config")
  conditionConfig Json?     @map("condition_config")
  actions         Json
  isEnabled       Boolean   @default(true) @map("is_enabled")
  isSystem        Boolean   @default(false) @map("is_system")
  triggerCount    Int       @default(0) @map("trigger_count")
  lastTriggeredAt DateTime? @map("last_triggered_at") @db.Timestamptz(6)
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation("AutomationRuleTenant", fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, projectId])
  @@index([tenantId, triggerType])
  @@map("automation_rules")
}

model ApiKey {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid // 铁律
  tenant     Tenant    @relation("ApiKeyTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  name       String    @db.VarChar(200)
  keyHash    String    @unique @map("key_hash") @db.VarChar(255) // 仅存哈希（SHA-256），明文 key 创建时一次性展示
  keyPrefix  String    @map("key_prefix") @db.VarChar(10) // 前 8 位，列表展示用
  scopes     String[]  @default([]) // 权限点白名单，空 = 全权限（按角色）
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy  String?   @map("revoked_by") @db.Uuid

  @@index([tenantId, createdAt])
  @@index([tenantId, lastUsedAt])
  @@map("api_keys")
}

model Webhook {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid // 铁律
  tenant           Tenant    @relation("WebhookTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  name             String    @db.VarChar(200)
  url              String    @db.VarChar(500) // 外发前 SSRF 校验（禁内网/环回/元数据地址，§3.3）
  secret           String    @db.VarChar(512) // AES-256 密文（ENCRYPTION_KEY 加密后存储，日志/响应不得泄露明文）
  secretKeyVersion Int       @default(1) @map("secret_key_version") // 密文密钥版本（密钥轮换支撑）
  events           String[]  @default([]) // 订阅事件名（domain-events 事件名）
  isActive         Boolean   @default(true) @map("is_active")
  lastTriggeredAt  DateTime? @map("last_triggered_at") @db.Timestamptz(6)
  triggerCount     Int       @default(0) @map("trigger_count")
  failureCount     Int       @default(0) @map("failure_count")
  createdBy        String    @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([tenantId, isActive])
  @@index([tenantId, deletedAt])
  @@map("webhooks")
}

/// 租户 AI 模型配置（每租户一条；管理员在「设置 → AI 模型」维护，全团队共用）
/// 端点为 OpenAI 兼容 /chat/completions；api_key 为 AES-256-GCM 密文，响应/日志/审计只出现末 4 位
model TenantLlmConfig {
  tenantId         String   @id @map("tenant_id") @db.Uuid // 铁律（一租户一条，主键即租户）
  tenant           Tenant   @relation("TenantLlmConfigTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  provider         String   @db.VarChar(20) // deepseek/zhipu/qwen/moonshot/openai/custom
  baseUrl          String   @map("base_url") @db.VarChar(500) // 外发前 SSRF 校验（同 Webhook，§3.3）
  model            String   @db.VarChar(100)
  apiKey           String   @map("api_key") @db.Text // AES-256-GCM 密文（ENCRYPTION_KEY）
  apiKeyKeyVersion Int      @default(1) @map("api_key_key_version") // 密文密钥版本（轮换支撑）
  apiKeyLast4      String   @map("api_key_last4") @db.VarChar(8) // 展示用
  updatedBy        String   @map("updated_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tenant_llm_configs")
}

model CalendarAccount {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid // 铁律
  tenant          Tenant    @relation("CalendarAccountTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  userId          String    @map("user_id") @db.Uuid
  provider        String    @default("feishu") @db.VarChar(20)
  accountName     String    @map("account_name") @db.VarChar(200)
  calendarId      String    @map("calendar_id") @db.VarChar(255)
  accessToken     String    @map("access_token") @db.Text // AES-256 密文（ENCRYPTION_KEY 加密；日志/响应不得泄露明文）
  refreshToken    String    @map("refresh_token") @db.Text // AES-256 密文
  tokenKeyVersion Int       @default(1) @map("token_key_version") // 密文密钥版本（轮换支撑）
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  isActive        Boolean   @default(true) @map("is_active")
  lastSyncedAt    DateTime? @map("last_synced_at") @db.Timestamptz(6)
  syncCount       Int       @default(0) @map("sync_count")
  failureCount    Int       @default(0) @map("failure_count")

  eventMappings CalendarEventMapping[] @relation("AccountEventMappings")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@index([userId])
  @@map("calendar_accounts")
}

model CalendarEventMapping {
  id            String          @id @default(uuid(7)) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid // 铁律
  tenant        Tenant          @relation("CalendarEventMappingTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  accountId     String          @map("account_id") @db.Uuid
  account       CalendarAccount @relation("AccountEventMappings", fields: [accountId], references: [id], onDelete: Cascade)
  taskId        String          @map("task_id") @db.Uuid
  eventId       String          @map("event_id") @db.VarChar(255)
  eventUid      String          @map("event_uid") @db.VarChar(255)
  syncState     String          @default("pending_create") @map("sync_state") @db.VarChar(20)
  lastSyncedAt  DateTime?       @map("last_synced_at") @db.Timestamptz(6)
  lastSyncError String?         @map("last_sync_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, taskId])
  @@index([accountId, eventId])
  @@index([syncState])
  @@map("calendar_event_mappings")
}

// ------------------------------------------------------------------
// 域 9：事务性 Outbox（§3.4 可靠性：关键事件可重放；DB 兜底扫描保证不丢）
// ------------------------------------------------------------------

/// 事务性 Outbox：与应用写操作同事务发布（INV：关键副作用必须可由扫描兜底补偿，§2.5 可靠性要求）
model OutboxEvent {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid // 铁律
  eventName     String   @map("event_name") @db.VarChar(80) // domain-events 事件名
  payload       Json     // §8.1 信封（eventId/occurredAt/tenantId/actor/version）
  status        String   @default("pending") @map("status") @db.VarChar(20) // pending/dispatched/failed
  attempts      Int      @default(0) @map("attempts")
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(6) // 分发锁（防多 worker 重复处理）
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(6) // 退避
  lastError     String?  @map("last_error") @db.VarChar(500)
  dispatchedAt  DateTime? @map("dispatched_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation("OutboxEventTenant", fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, nextAttemptAt])
  @@index([status, lockedUntil])
  @@map("outbox_events")
}

// ------------------------------------------------------------------
// 域 6 补全：AI apply 记录（§3.1 任务 3，INV-8：apply 持久化可查询关联，审计可回滚）
// ------------------------------------------------------------------

/// AI 提议应用记录：apply 时把 proposal 实际创建/更新的任务落库（INV-8：不依赖不可审计的 JSON）
model AiProposalTask {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid // 铁律
  proposalId String    @map("proposal_id") @db.Uuid
  taskId     String    @map("task_id") @db.Uuid // apply 后实际创建/更新的任务
  action     String    @db.VarChar(10) // created/updated（apply 语义）
  payload    Json? // apply 时的字段快照（diff 可回滚/撤销边界）
  appliedAt  DateTime  @map("applied_at") @db.Timestamptz(6)
  revertedAt DateTime? @map("reverted_at") @db.Timestamptz(6) // 撤销边界标记

  proposal AiProposal @relation("AiProposalTaskProposal", fields: [proposalId], references: [id], onDelete: Cascade)
  task     Task       @relation("AiProposalTaskTask", fields: [taskId], references: [id], onDelete: Restrict)
  tenant   Tenant     @relation("AiProposalTaskTenant", fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, proposalId])
  @@index([tenantId, taskId])
  @@map("ai_proposal_tasks")
}
