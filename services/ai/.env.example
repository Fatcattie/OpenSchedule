# OpenSchedule AI 服务环境变量（复制为 .env 后修改；真实凭据不进 git）
# 对应《开发方案》§3.7 环境变量清单；AI 服务无任何数据库凭据（永不直连业务库）

# —— 应用 ——
APP_ENV=development
APP_PORT=8300
LOG_LEVEL=INFO
# 逗号分隔的跨域白名单（默认空 = 仅内部网络访问，主服务经 SSE 代理转发）
CORS_ORIGINS=
# 错误上报（Sentry Envelope 直连；空 = no-op）：AI_SENTRY_DSN 优先，留空沿用 SENTRY_DSN
AI_SENTRY_DSN=
SENTRY_RELEASE=

# —— 服务间鉴权（§3.5.2：内部网络 + 服务 token）——
# 必须与主服务侧 AI_SERVICE_TOKEN 一致；生产环境务必替换为强随机值
AI_SERVICE_TOKEN=dev-ai-service-token-change-me

# —— LLM 调用参数 ——
# 模型端点 / API Key / 模型名不在这里配置：由团队管理员在 Web「设置 → AI 模型」配置（库内 AES-256-GCM 加密），
# 主服务随每次拆解请求下发；未配置时自动走确定性模板拆解。
# L1 铁律：temperature ≤ 0.2（配置超限启动直接失败）
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
# L1 校验失败重试次数（§3.5.4：≤3）
LLM_MAX_RETRIES=3
# 单次调用预算上限（美元，§3.5.4 默认 $0.5）
LLM_BUDGET_PER_CALL=0.5
# 月度预算告警线（美元；超限打日志，TODO 接告警通道）
LLM_MONTHLY_BUDGET_ALERT=50

# —— 主服务回调（AI 永不直连业务库；结果经 /internal/ai/results 交给主服务）——
MAIN_SERVICE_INTERNAL_URL=http://localhost:3000
CALLBACK_TIMEOUT_SECONDS=10
# 回调失败重试次数；耗尽后进死信（可查询/可重放，见 GET /ai/dead-letters）
AI_CALLBACK_MAX_ATTEMPTS=3

# —— AI 自有状态存储（R11：run 持久化 + 回调死信；不含任何业务数据）——
# auto=探测 Redis，连不上降级 memory 并打 ai_run_store_degraded 告警日志
# redis=连不上直接启动失败（生产必须，保证重启后 run 状态可恢复）
# memory=单进程（仅开发/单测；重启即丢帧）
AI_RUN_STORE=auto
# 与主服务逻辑隔离的独立 DB（默认 db 3）；键前缀 osai:，只存 run 帧与死信
AI_STATE_REDIS_URL=redis://localhost:6379/3
# run/死信键存活时长（秒）；超时后重连会得到 AI_RUN_NOT_FOUND
AI_STATE_TTL_SECONDS=3600
# 每个 run 保留的可重放帧上限（与 SSE 重放窗口一致）
AI_STATE_MAX_FRAMES=200
# 死信条数上限（有界，防长跑进程无界增长）
AI_DLQ_MAX_ENTRIES=200

# —— 拆解限制（§3.5.2 单次 ≤8-10 步；A4 深度 ≤4 层，计划为第 0 层）——
DECOMPOSE_MAX_TASKS=10
DECOMPOSE_MAX_DEPTH=4
