# ============================================================
# OpenSchedule .gitignore
# 原则：真实凭据不进 git（只提交 .env.example）；
#       依赖以快照形式入库（node_modules 受版本控制）——详见 README「依赖快照」一节
# ============================================================

# ---------- 构建产物 ----------
dist/
build/
coverage/
*.tsbuildinfo
# tsc -b 旧版产物：vite.config.js 会按 Vite 解析顺序（.js 先于 .ts）静默覆盖 vite.config.ts
apps/web/vite.config.js
apps/web/vite.config.d.ts
.vite/
.turbo/            # Turborepo 缓存（如后续启用 turbo）

# ---------- 环境变量（真实凭据绝不提交，只提交 .env.example） ----------
.env
.env.*
!.env.example
# 生产环境变量**模板**必须入库（真实值 deploy/.env.production 仍被 .env.* 排除）
!deploy/.env.production.example
# 演练/发布生成的证据报告不入库（属运行产物，按需粘贴摘要进 production-progress）
deploy/drill/evidence/
qa-load/evidence/

# ---------- Prisma ----------
# 迁移文件（services/api/prisma/migrations）必须提交——DDL 唯一权威来源；
# node_modules 内已生成的 Prisma Client 随依赖快照一起入库（见文末重新纳入规则）
**/.prisma/

# ---------- 日志与临时文件 ----------
*.log
logs/
.tmp/
.tmp-*
.DS_Store
Thumbs.db

# ---------- 编辑器 / IDE ----------
.idea/
.vscode/
*.swp

# ---------- Python（services/ai） ----------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.uv/

# ---------- 本地附件/导出落盘（开发环境；生产走对象存储） ----------
uploads/
local-data/

# ---------- 本地项目数据 / 工具缓存（绝不入库） ----------
.workbuddy/
.workbuddy-ai/
.repro/
dist-*/
dist-mvp-8/
.pnpm-store/
.DS_Store

# UmaDev runtime data
.umadev/
output/
opencode.json
# ---------- 依赖快照重新纳入（必须放在所有排除规则之后） ----------
# node_modules 为受版本控制的依赖快照：上述 dist/、build/、**/.prisma/、
# *.log 等规则不得误伤 node_modules 内的文件，故在末尾统一重新纳入。
# Windows 下 pnpm 使用 junction，Git 入库时展开为实体文件，
# clone 后无需安装、离线即可直接运行（含平台二进制：esbuild/prisma 引擎等）。
!**/node_modules/**
