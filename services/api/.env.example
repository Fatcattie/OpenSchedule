# ============================================================
# services/api 环境变量（示例文件）— 分组与变量名对应方案 chapter_03 §3.7「环境变量清单」
# 用法：
#   1) 复制为 services/api/.env（ConfigModule 优先读取 services/api/.env，未配置项回落根目录 .env）
#   2) 真实凭据绝不进 git（根 .gitignore 已忽略 .env*）
# 密钥生成参考：openssl rand -base64 32
# ============================================================

# ---------- 1. 应用 ----------
APP_ENV=development
APP_PORT=3000
APP_PUBLIC_URL=http://localhost:3000
# 跨域白名单，逗号分隔；前端 Vite dev 默认 http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# 可信反向代理跳数：空=不信任 X-Forwarded-For（本地直连）；经 Caddy 部署设 1（见 common/security/trust-proxy.ts）
TRUST_PROXY=

# ---------- 2. 数据库（PostgreSQL 16+） ----------
# 迁移策略 = 版本化迁移脚本（可回滚），schema.prisma 为 DDL 唯一权威来源（chapter_03 §3.2）
DATABASE_URL=postgresql://openschedule:change-me@localhost:5432/openschedule?schema=public
# 连接池上限（Prisma connection_limit 参数，自动拼入 URL）
DB_POOL_MAX=10
DB_SSL=false

# ---------- 3. Redis ----------
# BullMQ 队列 + zset 延迟提醒 + WS 广播 + 生产态幂等/refresh 吊销存储（Phase 1 为单实例内存实现，见 common 注释）
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=os:

# ---------- 4. 安全 ----------
# JWT：access 15m / refresh 7d（chapter_03 §3.7）
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# AES-256 密钥（32 字节 → base64 44 字符）：集成凭据加密落库（Phase 2+）
ENCRYPTION_KEY=change-me-32-bytes-base64

# ---------- 5. 邮件外发（R5 / D-04：SMTP 中继抽象） ----------
# 未配 SMTP_HOST 时邮件通道投递显式失败（lastError=EMAIL_ADAPTER_NOT_CONFIGURED），不影响站内通知；
# 本地开发建议 mailpit（deploy/docker-compose.yml 注释块，SMTP 1025 / Web 8025）
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=OpenSchedule <no-reply@openschedule.dev>

# ---------- 6. WebPush 外发（R5 / D-11） ----------
# 密钥对生成：npx web-push generate-vapid-keys；两键缺一即视为未配置（默认关闭，不产生 push 投递）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@openschedule.dev

# ---------- 7. IM 外发（R5：经 integrations 模块出口） ----------
# 通知 IM 通道供应商（feishu|dingtalk）与 integrations 通道模式（mcp|openapi|mock，详见 integrations.service.ts）
NOTIFICATION_IM_PROVIDER=feishu
INTEGRATION_FEISHU_MODE=mock
INTEGRATION_DINGTALK_MODE=mock
MCP_GATEWAY_URL=
# 外发重试扫描间隔（ms；BullMQ repeatable 主路径 + setInterval DB 兜底共用）
NOTIFICATION_RETRY_INTERVAL_MS=30000

# ---------- AI 服务（内部网络） ----------
# 主服务调用 AI 服务地址（端口 8300 与 services/ai/.env.example APP_PORT 一致，subagent_05 部署约定；容器内由 compose 覆盖为 http://ai:8300）
AI_SERVICE_URL=http://localhost:8300
# 内部服务互信 token（chapter_02 决策 6：AI 服务内部网络 + 服务 token 鉴权）
AI_SERVICE_TOKEN=change-me-service-token
# AI 服务回调主服务内部地址（变量名与 services/ai/app/config.py 的 MAIN_SERVICE_INTERNAL_URL 对齐；容器内由 compose 覆盖为 http://api:3000）
MAIN_SERVICE_INTERNAL_URL=http://localhost:3000

# 可观测性 / 种子
# 结构化日志级别（trace|debug|info|warn|error|fatal，默认 info）
LOG_LEVEL=info
# 慢查询阈值（毫秒，默认 200）：超过即打 db_slow_query 日志 + openschedule_db_slow_queries_total 指标
SLOW_QUERY_MS=200
# /metrics（Prometheus 抓取）开关，默认 true；'false'/'0'/'off' 关闭（返回 404）
METRICS_ENABLED=true
# 错误上报（Sentry Envelope 直连，零依赖；留空则 no-op）
# 仅上报 5xx（容器 → ExceptionFilter），事件含 requestId/traceId/路由标签 + 脱敏消息与 V8 栈，不含请求体/请求头。
SENTRY_DSN=
# 可选：事件 release 字段
SENTRY_RELEASE=
# 迁移不由 API 启动执行；发布或本地建库时显式运行 pnpm prisma:deploy。
# 该变量仅用于检测并阻止旧配置误上线，不再作为应用启动开关。
DB_AUTO_MIGRATE=false
# 演示数据开关（冷启动验证用，种子模块落地后生效）
SEED_DEMO_DATA=false
