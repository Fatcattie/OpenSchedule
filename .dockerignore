# ============================================================
# OpenSchedule Docker 构建上下文排除清单
# 三个 Dockerfile（apps/web、services/api、services/ai）的构建上下文
# 均为仓库根目录，本文件用于避免把本地依赖/凭据打进构建上下文
# ============================================================

# ---------- 依赖与构建产物 ----------
node_modules/
.pnpm-store/
dist/
build/
coverage/
*.tsbuildinfo
.vite/
.turbo/

# ---------- 环境与密钥（绝不进镜像） ----------
.env
.env.*
!.env.example

# ---------- Git / 编辑器 / 日志 ----------
.git/
.gitignore
.idea/
.vscode/
*.log
logs/
.DS_Store

# ---------- Python（services/ai） ----------
**/__pycache__/
**/*.pyc
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.uv/

# ---------- 本地数据 ----------
uploads/
local-data/
