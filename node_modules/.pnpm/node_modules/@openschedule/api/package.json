{
  "name": "@openschedule/api",
  "version": "0.1.0",
  "private": true,
  "description": "OpenSchedule 主后端（NestJS 模块化单体，唯一写库方）。技术栈锁定：NestJS 11 / Prisma 6 / class-validator / @nestjs/jwt / bcryptjs / TypeScript strict / Node >=22（方案 chapter_02 §1）。",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "openapi:check": "ts-node src/openapi/assemble.ts",
    "openapi:sync": "ts-node src/openapi/assemble.ts --write",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:diff": "prisma migrate diff --from-migrations=prisma/migrations --to-schema-datamodel=prisma/schema.prisma",
    "prisma:validate": "prisma validate",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/websockets": "^11.2.7",
    "@openschedule/domain-events": "workspace:*",
    "@openschedule/workspace-rules": "workspace:*",
    "@prisma/client": "^6.16.0",
    "@prometheus-io/client": "^0.16.1",
    "bcryptjs": "^3.0.2",
    "bullmq": "5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "nodemailer": "^10.0.13",
    "pino": "^9",
    "prisma": "^6.0.0",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
