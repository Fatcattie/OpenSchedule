# 移动端环境变量示例：复制为 .env.local 后按需填写（.env*.local 不入库）。
# 正式构建（eas build --profile preview/production）请改用 EAS 环境变量：
#   eas env:set --name EXPO_PUBLIC_API_URL --value https://你的域名 --environment production --visibility plaintext

# 后端源站（协议 + 域名 [+ 端口]，不含 /api/v1）。真机调试本机后端时填电脑局域网 IP，如 http://192.168.1.10:3000
EXPO_PUBLIC_API_URL=

# mock 开关：true / false；留空 = 填了 EXPO_PUBLIC_API_URL 就走真实后端，否则走 mock
EXPO_PUBLIC_USE_MOCK=

# EAS 项目 ID 覆盖值；留空 = app.config.ts 内置的 @bigcatleos-team/openschedule
EAS_PROJECT_ID=
