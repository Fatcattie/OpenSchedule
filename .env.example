# ============================================================
# OpenSchedule 环境变量清单（示例文件）
# 分组与变量名：方案 chapter_03 §3.7「环境变量清单」共 15 组，逐组对应
# 用法：
#   1) cp .env.example .env
#   2) 按需修改；真实凭据绝不进 git（根 .gitignore 已忽略 .env*）
# 密钥生成参考：
#   openssl rand -base64 32                          # JWT 密钥 / ENCRYPTION_KEY（AES-256）
#   npx web-push generate-vapid-keys                 # VAPID 密钥对
# 重要：根目录 .env 与 deploy/docker-compose.yml 共用；
#   容器内网络地址由 compose 的 environment 自动覆盖（localhost → 服务名），无需手改。
# ============================================================

# ---------- 1. 应用（Phase 1） ----------
APP_ENV=development
APP_PORT=3000
APP_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173
# AI 服务（FastAPI）端口：容器内外均为 8300（与 services/ai/.env.example 的 APP_PORT=8300 一致）
APP_PORT_AI=8300
# 主服务调用 AI 服务的地址；容器内由 compose 覆盖为 http://ai:8300
AI_SERVICE_URL=http://localhost:8300

# ---------- 2. 数据库（Phase 1） ----------
# PostgreSQL 16+；迁移策略 = 版本化迁移脚本（可回滚），schema.prisma 为 DDL 唯一权威来源
DATABASE_URL=postgresql://openschedule:openschedule@localhost:5432/openschedule?schema=public
DB_POOL_MAX=10
DB_SSL=false
# ↓ 以下三个变量仅供 deploy/docker-compose.yml 初始化本地 postgres 使用（容器网络地址由 compose 覆盖）
POSTGRES_USER=openschedule
POSTGRES_PASSWORD=openschedule
POSTGRES_DB=openschedule

# ---------- 3. Redis（Phase 1） ----------
# BullMQ 队列 + zset 延迟提醒 + WS 广播；REDIS_PREFIX 避免多环境 key 冲突
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=os:
# Redis 快速失败参数（Redis 宕机时避免请求挂死）：套接字连接超时 / 重连上限 / 失败后冷却窗口
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_CONNECT_MAX_RETRIES=2
REDIS_RETRY_COOLDOWN_MS=15000

# ---------- 4. 安全（Phase 1） ----------
# JWT + refresh token（TTL 见方案：access 15m / refresh 7d）
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# AES-256 密钥（32 字节 → base64 44 字符）：加密落库的集成凭据（OAuth token / IM webhook 等）
ENCRYPTION_KEY=change-me-encryption-key-32-bytes
# 内部服务互信：api ↔ ai 内部调用使用的服务 token（方案 chapter_02：AI 服务内部网络 + 服务 token 鉴权）
AI_SERVICE_TOKEN=change-me-ai-service-token
# AI 服务回调主服务的内部地址（变量名与 AI 侧 config.py 对齐）；容器内由 compose 覆盖为 http://api:3000
MAIN_SERVICE_INTERNAL_URL=http://localhost:3000

# ---------- 5. 对象存储（Phase 1） ----------
# S3 兼容：本地 MinIO 模拟，生产切 OSS/COS 只改配置
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=openschedule
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
# 浏览器直访附件的公网/宿主地址（bucket 会自动拼接）；容器内由 compose 覆盖为宿主地址
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/openschedule
# ↓ 以下两个变量仅供 deploy/docker-compose.yml 初始化本地 MinIO 使用
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# ---------- 6. 邮件（Phase 1） ----------
# 供应商未定（国内可达性 POC 后定）；SMTP 抽象保证可换。
# 本地开发建议配合 mailpit（compose 内置注释块，见 deploy/README 启用方式）
MAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=OpenSchedule <no-reply@openschedule.dev>

# ---------- 7. WebPush（Phase 1） ----------
# 国产浏览器/企业内网可用性待实测（方案 §4.7 风险项），默认开关待定
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@openschedule.dev

# ---------- 8. IM 通知（Phase 1） ----------
# 企微/飞书/钉钉群机器人 webhook：租户级地址存 DB，此处为全局默认 base（预留）
WECOM_WEBHOOK_BASE_URL=
FEISHU_WEBHOOK_BASE_URL=
DINGTALK_WEBHOOK_BASE_URL=
# 通知外发 IM 通道的默认供应商（feishu|dingtalk；非法值回落 feishu）
NOTIFICATION_IM_PROVIDER=feishu
# integrations 通道模式：mcp | openapi | mock（默认 mock；mcp 需配 MCP_GATEWAY_URL，网关不可达自动降级 mock）
INTEGRATION_FEISHU_MODE=mock
INTEGRATION_DINGTALK_MODE=mock
MCP_GATEWAY_URL=
# 通知外发重试扫描间隔（ms；BullMQ repeatable 主路径 + 同间隔 setInterval DB 兜底）
NOTIFICATION_RETRY_INTERVAL_MS=30000

# ---------- 9. AI 模型（D-14：管理员统一配置，已移除 LiteLLM） ----------
# 模型厂商 / 接口地址 / 模型名 / API Key 不在环境变量里：团队管理员登录后在「设置 → AI 模型」配置，
# 库内 AES-256-GCM 加密（ENCRYPTION_KEY），主服务随请求下发给 AI 服务；未配置时 AI 功能使用本地规则引擎。
# 主服务同步等待 AI 拆解的上限（毫秒；超时保留规则引擎结果）
AI_DECOMPOSE_TIMEOUT_MS=90000
# 单次调用预算上限（美元）与月度预算告警阈值（超出告警不中断）
LLM_BUDGET_PER_CALL=0.5
LLM_MONTHLY_BUDGET_ALERT=50

# ---------- 9.1 AI 服务状态存储（R11：run 持久化 + 回调死信） ----------
# auto=探测 Redis，连不上降级 memory 并告警；redis=生产（连不上即启动失败）；memory=单进程开发
AI_RUN_STORE=auto
# AI 自有 Redis DB（与主服务逻辑隔离，键前缀 osai:；容器内 compose 覆盖为 redis://redis:6379/3）
AI_STATE_REDIS_URL=redis://localhost:6379/3
AI_STATE_TTL_SECONDS=3600
AI_STATE_MAX_FRAMES=200
AI_DLQ_MAX_ENTRIES=200
AI_CALLBACK_MAX_ATTEMPTS=3

# ---------- 10. 日历 OAuth（Phase 2） ----------
# 日历双向同步（Google / 飞书 / 企微）；回调地址由 OAUTH_CALLBACK_BASE_URL 拼接
OAUTH_CALLBACK_BASE_URL=http://localhost:3000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=

# ---------- 11. 沙箱（Phase 3） ----------
# AI 执行 v1（仅内容型任务）运行环境；E2B 默认（B18 POC 后定稿）
SANDBOX_PROVIDER=e2b
E2B_API_KEY=

# ---------- 12. 浏览器自动化（Phase 3） ----------
# Playwright MCP 为默认（B18 POC 后定稿）
BROWSER_PROVIDER=playwright-mcp

# ---------- 13. Git 集成（Phase 3） ----------
# commit 关联 / PR 同步 / 合并自动完成任务（E4）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_APP_ID=
GITLAB_APP_SECRET=

# ---------- 14. 可观测性（Phase 1） ----------
# 审计日志独立于应用日志（append-only，audit_logs 表，不属于本组）
# 错误上报（Sentry Envelope 直连，零依赖）：留空则完全 no-op；官方 DSN 形如
#   https://<publicKey>@o<org>.ingest.sentry.io/<projectId>
# 仅上报 5xx（含 requestId/traceId/路由标签与脱敏后的消息+栈），不带请求体/请求头。
SENTRY_DSN=
# 可选：上报事件里的 release（默认不发送，Sentry 侧回落为 unknown）
SENTRY_RELEASE=
# 浏览器端（apps/web）：本地开发用 VITE_SENTRY_DSN；生产镜像改由 WEB_SENTRY_DSN 运行时注入 /runtime-config.js
VITE_SENTRY_DSN=
# AI 服务：AI_SENTRY_DSN 优先，留空沿用 SENTRY_DSN（只报非预期异常，不含提示词/模型输出）
AI_SENTRY_DSN=
# 告警通知（pnpm docker:obs 时 alert-bridge 读取；Alertmanager → 飞书/钉钉/企业微信群机器人，全部留空 = 只记日志）
ALERT_FEISHU_WEBHOOK=
ALERT_FEISHU_SECRET=
ALERT_DINGTALK_WEBHOOK=
ALERT_DINGTALK_SECRET=
ALERT_WECOM_WEBHOOK=
ALERT_WEBHOOK_URL=
# 结构化日志级别（trace|debug|info|warn|error|fatal，默认 info）
LOG_LEVEL=info
# R9 结构化日志 + 指标：慢查询阈值（ms，超出即 db_slow_query 日志 + 计数指标）与 Prometheus /metrics 开关
SLOW_QUERY_MS=200
METRICS_ENABLED=true
# R9 可观测性栈（pnpm docker:obs，profile=observability）：Grafana 管理员密码（Prometheus 无鉴权，仅本地栈）
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---------- 15. 种子 / 迁移（Phase 1） ----------
# 迁移不由 API 启动执行；发布或本地建库时显式运行 pnpm prisma:deploy。
# 保留此变量仅用于检测并阻止旧配置误上线，不再作为应用启动开关。
DB_AUTO_MIGRATE=false
# 演示数据开关（冷启动验证用；随种子模块落地）
SEED_DEMO_DATA=false

# ---------- 16. 生产部署（R10） ----------
# 生产环境变量**不在本文件**：见 deploy/.env.production.example（复制为 deploy/.env.production，已被 .gitignore 排除）。
# 生产编排：pnpm docker:prod:config 校验 / pnpm docker:prod 启动（= deploy/docker-compose.prod.yml）。
# 关键密钥用 ${VAR:?} fail-fast：缺失即拒绝启动（OWASP 风格「无默认口令」），运维手册见 docs/ops/runbook.md。
# CI/CD：.github/workflows/release.yml（推 v* tag → 三镜像 → staging 自动（目标机迁移） → production 人工审批）。
