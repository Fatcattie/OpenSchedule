# OpenSchedule AI 服务环境变量（复制为 .env 后修改；真实凭据不进 git）
# 对应《开发方案》§3.7 环境变量清单；AI 服务无任何数据库凭据（永不直连业务库）

# —— 应用 ——
APP_ENV=development
APP_PORT=8300
LOG_LEVEL=INFO
# 逗号分隔的跨域白名单（默认空 = 仅内部网络访问，主服务经 SSE 代理转发）
CORS_ORIGINS=

# —— 服务间鉴权（§3.5.2：内部网络 + 服务 token）——
# 必须与主服务侧 AI_SERVICE_TOKEN 一致；生产环境务必替换为强随机值
AI_SERVICE_TOKEN=dev-ai-service-token-change-me

# —— LLM（§3.7：凭据只放 LiteLLM，应用不直连供应商）——
LITELLM_URL=http://localhost:4000/v1
LITELLM_API_KEY=sk-litellm-dev-placeholder
# C20 默认 DeepSeek/GLM 档；Phase 1 第 1-2 周跑 3 模型 × 100 次 eval 后定稿
LLM_DEFAULT_MODEL=deepseek-chat
# 拆解专用模型（可选；空 = 跟随 LLM_DEFAULT_MODEL）
LLM_PLANNING_MODEL=
# L1 铁律：temperature ≤ 0.2（配置超限启动直接失败）
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
# L1 校验失败重试次数（§3.5.4：≤3）
LLM_MAX_RETRIES=3
# 单次调用预算上限（美元，§3.5.4 默认 $0.5）
LLM_BUDGET_PER_CALL=0.5
# 月度预算告警线（美元；超限打日志，TODO 接告警通道）
LLM_MONTHLY_BUDGET_ALERT=50

# —— 主服务回调（AI 永不直连业务库；结果经 /internal/ai/results 交给主服务）——
MAIN_SERVICE_INTERNAL_URL=http://localhost:3000
CALLBACK_TIMEOUT_SECONDS=10

# —— 拆解限制（§3.5.2 单次 ≤8-10 步；A4 深度 ≤4 层，计划为第 0 层）——
DECOMPOSE_MAX_TASKS=10
DECOMPOSE_MAX_DEPTH=4
