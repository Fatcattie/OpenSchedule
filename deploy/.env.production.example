# ============================================================
# OpenSchedule 生产环境变量模板（R10）
# 用法：
#   cp deploy/.env.production.example deploy/.env.production
#   # 填入真实值；.env.production 已被 .gitignore 排除（绝不入库）
#   docker compose --env-file deploy/.env.production -f deploy/docker-compose.prod.yml config
#
# 约定：
#   - 标 [必填] 的变量在 docker-compose.prod.yml 中以 ${VAR:?} 引用：缺失/为空 → compose 直接报错，
#     杜绝 change-me 默认值上生产（方案 production-ddd-design §3.7 风险项）。
#   - 标 [可选] 的留空即走功能降级（如未配 SENTRY_DSN → 错误上报 no-op）。
#   - 密钥生成参考：openssl rand -base64 32
# ============================================================

# ---------- 1. 镜像与发布（CD 决定） ----------
# [必填] 镜像仓库前缀（GHCR 例：ghcr.io/<org>）；镜像名 = $REGISTRY/openschedule-{api,web,ai}
REGISTRY=ghcr.io/example-org
# [必填] 发布版本 = git tag / commit sha（不可变 tag；回滚即改回上一 tag）
IMAGE_TAG=v0.1.0
# [必填] 对外域名（Caddy 自动申请 Let's Encrypt 证书；需 80/443 可达 + DNS 已解析）
DOMAIN=openschedule.example.com
# [必填] ACME 账号邮箱（证书到期/异常通知）
ACME_EMAIL=ops@example.com

# ---------- 2. 数据库（容器内部网络；不对宿主暴露端口） ----------
# [必填] 生产请用强口令（≥24 随机字符）
POSTGRES_USER=openschedule
POSTGRES_PASSWORD=
POSTGRES_DB=openschedule
# [可选] 备份保留天数与间隔（秒）；默认 14 天 / 86400 秒
BACKUP_RETAIN_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# ---------- 3. Redis ----------
# 容器内固定 redis://redis:6379/0（compose 已写死）；如需独立实例改 docker-compose.prod.yml

# ---------- 3.1 AI 状态存储（R11：run 持久化 + 回调死信） ----------
# [必填] 生产必须 redis：AI 重启后 run 状态/帧仍可恢复；连不上 → AI 启动失败（fail-fast）
AI_RUN_STORE=redis
# AI 自有 DB（与主服务逻辑隔离：db 3 + osai: 前缀；compose 内固定 redis://redis:6379/3）
AI_STATE_REDIS_URL=redis://redis:6379/3
AI_STATE_TTL_SECONDS=3600
AI_STATE_MAX_FRAMES=200
AI_DLQ_MAX_ENTRIES=200
AI_CALLBACK_MAX_ATTEMPTS=3

# ---------- 4. 对象存储（默认自托管 MinIO；切云 OSS/COS 只改 STORAGE_*） ----------
# [必填] MinIO 管理员凭据（生产用强口令）
MINIO_ROOT_USER=openschedule
MINIO_ROOT_PASSWORD=
# [可选] 存储桶名（默认 openschedule）
STORAGE_BUCKET=openschedule

# ---------- 5. 应用安全密钥（§3.7；生产必须轮换，勿沿用示例 change-me） ----------
# [必填] JWT access/refresh 密钥（各自独立随机；openssl rand -base64 48）
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# [必填] AES-256 集成凭据加密密钥（32 字节 base64 = 44 字符；openssl rand -base64 32）
ENCRYPTION_KEY=
# [必填] 主服务↔AI 服务内部互信 token（两侧须一致）
AI_SERVICE_TOKEN=

# ---------- 6. AI 模型（D-14） ----------
# 部署时无需任何模型 key：上线后由团队管理员在 Web「设置 → AI 模型」选择厂商并填写 API Key
# （库内 AES-256-GCM 加密，依赖上面的 ENCRYPTION_KEY）。未配置时 AI 功能自动使用本地规则引擎。
# [可选] 主服务同步等待 AI 拆解的上限（毫秒，默认 90000；超时保留规则引擎结果）
AI_DECOMPOSE_TIMEOUT_MS=90000

# ---------- 7. 通知外发（未配置则通道降级为显式失败，不影响站内通知） ----------
MAIL_FROM=OpenSchedule <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# [可选] WebPush VAPID 密钥对（两键缺一视为未配置）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
# [可选] IM 通道供应商与模式（feishu|dingtalk；mcp|openapi|mock）
NOTIFICATION_IM_PROVIDER=feishu
INTEGRATION_FEISHU_MODE=openapi
INTEGRATION_DINGTALK_MODE=openapi
MCP_GATEWAY_URL=

# ---------- 8. 可观测性（R9） ----------
LOG_LEVEL=info
SLOW_QUERY_MS=500
METRICS_ENABLED=true
# [可选] Sentry DSN（留空 = 不报错外发）：主服务 5xx
SENTRY_DSN=
# [可选] 默认取 IMAGE_TAG（web）；api/ai 留空则不发送 release
SENTRY_RELEASE=
# [可选] 浏览器端 DSN（公开值，运行时写入 /runtime-config.js；建议独立 Sentry 项目）
WEB_SENTRY_DSN=
# [可选] AI 服务 DSN；留空则沿用 SENTRY_DSN
AI_SENTRY_DSN=
# [可选] 告警通知通道（profile=observability；alert-bridge 读取，全部留空 = 告警只在 Prometheus/Alertmanager UI 可见）
ALERT_FEISHU_WEBHOOK=
ALERT_FEISHU_SECRET=
ALERT_DINGTALK_WEBHOOK=
ALERT_DINGTALK_SECRET=
ALERT_WECOM_WEBHOOK=
ALERT_WEBHOOK_URL=
# [必填] Grafana 管理员口令（profile=observability 时生效）
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ---------- 9. 其它 ----------
CORS_ORIGINS=https://openschedule.example.com
DB_AUTO_MIGRATE=false
SEED_DEMO_DATA=false
